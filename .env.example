NEXT_PUBLIC_SHORT_TITLE=
NEXT_PUBLIC_SITE_SUBTITLE=
NEXT_PUBLIC_SITE_TITLE=
# Language of the site's content, for <html lang> (screen readers pick their voice from it).
NEXT_PUBLIC_SITE_LANG=en
NEXT_PUBLIC_SITE_URL=
# Spree storefront key: server-only, added by pages/api/public/[...path].ts.
# Never prefix it NEXT_PUBLIC_ (those values are inlined into the browser bundle).
SPREE_ACCESS_TOKEN=
NEXT_PUBLIC_SPREE_API_URL=
# Optional server-side Spree URL (e.g. an internal host); defaults to NEXT_PUBLIC_SPREE_API_URL.
SPREE_API_URL=
NEXT_PUBLIC_TWITTER_SLUG=
NEXT_PUBLIC_FACEBOOK_SLUG=
NEXT_PUBLIC_INSTAGRAM_SLUG=
NEXT_PUBLIC_VIDEO_URL=
SPREE_ACCESS_TOKEN=
NEXT_PUBLIC_SPREE_API_URL=
NEXT_PUBLIC_TRACKING_PROVIDER_GA=
NEXT_PUBLIC_TRACKING_PROVIDER_KM=
NEXT_PUBLIC_TRACKING_VERBOSE=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_KONTENT_PROJECT_ID=
NEXT_PUBLIC_KONTENT_MGMT_KEY=
SPREE_ACCESS_TOKEN=
NEXT_PUBLIC_SPREE_API_URL=
NEXT_PUBLIC_TRACKING_GA_ON=off
NEXT_PUBLIC_TRACKING_KM_ON=off
NEXT_PUBLIC_TRACKING_PROVIDER_GA=off
NEXT_PUBLIC_TRACKING_PROVIDER_KM=off
NEXT_PUBLIC_TRACKING_VERBOSE=off
NEXT_PUBLIC_TRACKING=off
NEXT_PUBLIC_TWITTER_SLUG=
NEXT_PUBLIC_FACEBOOK_SLUG=
NEXT_PUBLIC_INSTAGRAM_SLUG=
NEXT_PUBLIC_TRACKING_VERBOSE=
NEXT_PUBLIC_TRACKING=
# App store links for the "get the app" callouts, a build-time fallback: the
# admin's App Links homepage section overrides them. A TestFlight link is shown
# as a beta. A platform with neither is left out; with no link at all no
# callout renders.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# Spree taxon whose products fill the Featured shelf on /browse, in the admin's
# taxon order. Defaults to collections/featured; a missing or empty taxon shows no shelf.
NEXT_PUBLIC_FEATURED_TAXON=

# Digital products (dna-admin's digital assets and buyer library).
# Kinds in display order, each `kind`, `kind:Label` or `kind:Label:Plural`,
# comma separated, e.g. ebook:E-book:E-books,course. Empty shows any kind the
# backend sends, labelled from its name.
NEXT_PUBLIC_DIGITAL_KINDS=
# Optional link that opens a library item in a native app, e.g.
# exampleapp://library; items link to <url>/<variant id>. Empty hides "Open in app".
NEXT_PUBLIC_APP_LIBRARY_URL=
# Creator marketplace: the Spree taxon creators' approved products join (the
# backend's CREATORS_MARKETPLACE_TAXON, default marketplace). Empty turns the
# marketplace off: no Shop / Marketplace switch on /browse, no Creator entry
# in the account menu.
NEXT_PUBLIC_MARKETPLACE_TAXON=
# Optional creator share for /creators to advertise (e.g. 70); empty says none.
NEXT_PUBLIC_CREATOR_SHARE_PERCENT=

# Sentry. Leave NEXT_PUBLIC_SENTRY_DSN empty to disable reporting entirely.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# Server-side overrides (default to the NEXT_PUBLIC_ values above).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
# Build-time only, for source map upload; all three are needed or upload is skipped.
# The token needs the project:releases scope.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Affiliate program (dna-admin's affiliates). The public /affiliates page states
# the backend's default terms; set these when Affiliates.config differs.
# Commission in basis points (1000 = 10%), cookie window and approval hold in days.
NEXT_PUBLIC_AFFILIATE_COMMISSION_BPS=
NEXT_PUBLIC_AFFILIATE_COOKIE_DAYS=
NEXT_PUBLIC_AFFILIATE_HOLD_DAYS=

# Storefront chat and visitor tracking (dna-admin's /api/v1/storefront chat and
# visit API, on NEXT_PUBLIC_SPREE_API_URL). The chat widget is off unless set to
# true. Visitor tracking (visit pings for the admin's live Visitors screen)
# follows the chat flag when unset; set it to true or false to override. The
# only thing either stores is a random visitor token in localStorage.
NEXT_PUBLIC_CHAT_ENABLED=
NEXT_PUBLIC_VISITOR_TRACKING=
